# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project URL and anon (public) key: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service role key: server only. Used by the admin dashboard and rate limiting.
# NEVER prefix with NEXT_PUBLIC_ and never import it in client components.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Public site URL, used for share links and auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: image moderation provider (see docs/IMAGE_MODERATION.md)
# IMAGE_MODERATION_API_KEY=
